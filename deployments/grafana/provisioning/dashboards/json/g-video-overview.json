{
  "title": "g-video 服务监控",
  "uid": "g-video-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP QPS (按接口)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count[1m])) by (path)",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP P99 延迟 (秒)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (path, le))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "gRPC QPS (按方法)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [
        {
          "expr": "sum(rate(grpc_server_handling_seconds_count[1m])) by (method)",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "gRPC 错误率 (code != OK)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": null },
      "targets": [
        {
          "expr": "sum(rate(grpc_server_handling_seconds_count{code!=\"OK\"}[5m])) by (method)",
          "legendFormat": "{{method}}"
        }
      ]
    }
  ]
}
